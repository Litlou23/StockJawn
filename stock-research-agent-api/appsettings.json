{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ENSEMBLE_SCORING_ENABLED": "true",
  "LearningGuardrails": {
    "Frozen": false,
    "MinSampleSize": 50,
    "MinCalibrationSample": 30,
    "MinCapBoostSample": 15,
    "MinPatternEvidence": 10,
    "MaxDailyMovement": 0.01,
    "MaxCumulativeAdjustment": 0.20,
    "MaxCalibrationMovement": 0.01,
    "MaxCapBoostMovement": 2.0,
    "RequiredZScore": 1.645,
    "EnforceConfidenceInterval": true,
    "EnforceAccuracyTrend": true,
    "RecentWindowDays": 30,
    "MinRecentSample": 10,
    "MaxAccuracyDecline": 0.10,
    "EnforceRegimeConsistency": true,
    "MinRegimeSample": 10,
    "MaxRegimeSpread": 0.25,
    "RegimeThrottleFactor": 0.5
  }
}
